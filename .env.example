# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.valuegradeagency.com

# "Book a Strategy Call" destination (Calendly, Google Calendar booking page, etc.).
# If empty, the button links to /contact?intent=call
NEXT_PUBLIC_BOOKING_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile spam protection. Leave both empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Form delivery via Resend (https://resend.com). Required in production.
RESEND_API_KEY=
FORMS_TO_EMAIL=hello@valuegradeagency.com
FORMS_FROM_EMAIL="VGA Website <forms@valuegradeagency.com>"

# Grade (usegrade.com) SDK API, used by the client / creator portal. Server-side only, never NEXT_PUBLIC_.
# Leave empty to run the portal in demo mode with sample data. Docs: https://api-docs.usegrade.com
# The key needs: campaigns read, payouts:read, approvals:read, approvals:write and KYC access.
GRADE_BASE_URL=
GRADE_APP_ID=
GRADE_API_KEY=

# Postgres for portal accounts, sessions and admin data (Neon / Vercel Postgres: use the pooled URL).
# Leave empty locally to use the embedded database in ./data/pglite. Required on Vercel.
DATABASE_URL=

# Google Search Console verification token (the content="..." value only). Optional.
GOOGLE_SITE_VERIFICATION=

# Admin dashboard (/admin). Server-side only.
# ADMIN_PASSWORD signs you in. ADMIN_SESSION_SECRET signs the session cookie: use a long random
# string, e.g. `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Folder for the embedded local database and legacy data import. Defaults to ./data.
# ADMIN_DATA_DIR=
